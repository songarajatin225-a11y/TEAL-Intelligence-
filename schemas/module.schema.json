{
  "$id": "https://songarajatin225-a11y.github.io/TEAL-Intelligence-/schemas/module.schema.json",
  "title": "Module",
  "description": "TEAL Engineering Intelligence OS — Module record (id prefix \"mod-\"). Generated from src/domain; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,6}-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "TEAL_INTERNAL",
        "PUBLIC",
        "EXTERNAL",
        "DEMO",
        "CALCULATED",
        "INFERRED",
        "AI_GENERATED",
        "USER_CREATED"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "document": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "SOURCE_DOCUMENTED",
            "CALCULATED",
            "INFERRED",
            "DRAFT",
            "ASSUMPTION",
            "UNKNOWN",
            "CONFLICTED",
            "STALE"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "verification_status"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "manufactures",
              "uses",
              "compatible_with",
              "applies_to",
              "built_from",
              "supplied_by",
              "tested_by",
              "derived_from",
              "similar_to",
              "used_in",
              "requires",
              "validated_by",
              "learned_from",
              "belongs_to",
              "references",
              "evidence_for"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "rel",
          "target"
        ]
      }
    },
    "status": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "next_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "notes": {
      "type": "string"
    },
    "entity": {
      "type": "string",
      "const": "module"
    },
    "key": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "automation",
        "software",
        "connectivity",
        "compliance"
      ]
    },
    "group": {
      "type": "string"
    },
    "module_type": {
      "type": "string"
    },
    "price_estimate_inr": {
      "type": [
        "number",
        "null"
      ]
    },
    "fitment": {
      "type": "object",
      "properties": {
        "fam": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noFam": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noDeliv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noPlat": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mat": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "module_version": {
      "type": "string"
    },
    "mechanical_interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "electrical_interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "communication": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "utilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "string"
    },
    "payload": {
      "type": "string"
    },
    "accuracy": {
      "type": "string"
    },
    "cycle_time": {
      "type": "string"
    },
    "supplier_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternate_supplier_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "data_type",
    "provenance",
    "entity",
    "key",
    "kind",
    "group",
    "price_estimate_inr"
  ]
}
