{
  "$id": "https://songarajatin225-a11y.github.io/TEAL-Intelligence-/schemas/equipment_template.schema.json",
  "title": "Equipment template",
  "description": "TEAL Engineering Intelligence OS — Equipment template record (id prefix \"eqt-\"). Generated from src/domain; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,6}-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "TEAL_INTERNAL",
        "PUBLIC",
        "EXTERNAL",
        "DEMO",
        "CALCULATED",
        "INFERRED",
        "AI_GENERATED",
        "USER_CREATED"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "document": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "SOURCE_DOCUMENTED",
            "CALCULATED",
            "INFERRED",
            "DRAFT",
            "ASSUMPTION",
            "UNKNOWN",
            "CONFLICTED",
            "STALE"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "verification_status"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "manufactures",
              "uses",
              "compatible_with",
              "applies_to",
              "built_from",
              "supplied_by",
              "tested_by",
              "derived_from",
              "similar_to",
              "used_in",
              "requires",
              "validated_by",
              "learned_from",
              "belongs_to",
              "references",
              "evidence_for"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "rel",
          "target"
        ]
      }
    },
    "status": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "next_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "notes": {
      "type": "string"
    },
    "entity": {
      "type": "string",
      "const": "equipment_template"
    },
    "code": {
      "type": "string"
    },
    "group": {
      "type": "string",
      "enum": [
        "Laser",
        "Electronics",
        "Semiconductor",
        "Battery",
        "General Automation"
      ]
    },
    "domain_id": {
      "type": "string"
    },
    "application": {
      "type": "string"
    },
    "process": {
      "type": "string"
    },
    "stations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "load",
              "buffer",
              "fixture",
              "align",
              "vision",
              "motion",
              "process",
              "laser",
              "inspect",
              "sort",
              "unload",
              "transfer",
              "assembly",
              "test",
              "manual"
            ]
          },
          "function": {
            "type": "string"
          },
          "time_s": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "time_basis": {
            "type": "string",
            "enum": [
              "CALCULATED",
              "EMPIRICAL",
              "USER_INPUT",
              "MANUFACTURER_DATA",
              "VALIDATED",
              "ASSUMPTION",
              "DEMO"
            ]
          },
          "dist": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "fixed",
                  "uniform",
                  "triangular",
                  "normal"
                ]
              },
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "minimum": 0
              },
              "mode": {
                "type": "number",
                "minimum": 0
              },
              "sd": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "type"
            ]
          },
          "laser": {
            "type": "object",
            "properties": {
              "path_mm": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "area_mm2": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hatch_mm": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "speed_mm_s": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "passes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "jump_overhead_s": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "power_w": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "frequency_khz": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pulse_width_ns": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "parallel": {
            "default": 1,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "buffer_after": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reject_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rework_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mtbf_min": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "mttr_min": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "changeover_min": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "power_kw": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "footprint_m2": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "capex": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "operator": {
            "type": "boolean"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "product_type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "quantity": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "role",
                "product_type"
              ]
            }
          }
        },
        "required": [
          "key",
          "name",
          "kind",
          "time_s"
        ]
      }
    },
    "has_laser_chain": {
      "type": "boolean"
    },
    "application_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_id": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "data_type",
    "provenance",
    "entity",
    "code",
    "group",
    "application",
    "stations"
  ]
}
