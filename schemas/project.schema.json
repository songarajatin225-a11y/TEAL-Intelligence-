{
  "$id": "https://songarajatin225-a11y.github.io/TEAL-Intelligence-/schemas/project.schema.json",
  "title": "Project",
  "description": "TEAL Engineering Intelligence OS — Project record (id prefix \"prj-\"). Generated from src/domain; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,6}-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "TEAL_INTERNAL",
        "PUBLIC",
        "EXTERNAL",
        "DEMO",
        "CALCULATED",
        "INFERRED",
        "AI_GENERATED",
        "USER_CREATED"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "document": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "SOURCE_DOCUMENTED",
            "CALCULATED",
            "INFERRED",
            "DRAFT",
            "ASSUMPTION",
            "UNKNOWN",
            "CONFLICTED",
            "STALE"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "verification_status"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "manufactures",
              "uses",
              "compatible_with",
              "applies_to",
              "built_from",
              "supplied_by",
              "tested_by",
              "derived_from",
              "similar_to",
              "used_in",
              "requires",
              "validated_by",
              "learned_from",
              "belongs_to",
              "references",
              "evidence_for"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "rel",
          "target"
        ]
      }
    },
    "status": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "next_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "notes": {
      "type": "string"
    },
    "entity": {
      "type": "string",
      "const": "project"
    },
    "customer_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "configuration_id": {
      "type": "string"
    },
    "bom_id": {
      "type": "string"
    },
    "cost_model_id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "budget": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": "string",
      "enum": [
        "INR",
        "USD",
        "EUR",
        "JPY",
        "GBP",
        "CNY"
      ]
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Blocked",
              "Completed"
            ]
          },
          "milestone": {
            "type": "boolean"
          },
          "gate_code": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "start",
          "end",
          "status"
        ]
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gate_code": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "PENDING",
              "GO",
              "GO WITH CONDITIONS",
              "NO-GO"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
          },
          "approvers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string"
                },
                "mandatory": {
                  "type": "boolean"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "provided",
                    "missing",
                    "not_applicable"
                  ]
                },
                "reference": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "item",
                "mandatory",
                "status"
              ]
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "due": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
                },
                "closed": {
                  "type": "boolean"
                }
              },
              "required": [
                "text",
                "owner",
                "due"
              ]
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "gate_code",
          "decision",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "data_type",
    "provenance",
    "entity",
    "tasks",
    "gates"
  ]
}
