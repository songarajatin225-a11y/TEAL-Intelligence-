{
  "$id": "https://songarajatin225-a11y.github.io/TEAL-Intelligence-/schemas/product.schema.json",
  "title": "Product",
  "description": "TEAL Engineering Intelligence OS — Product record (id prefix \"prd-\"). Generated from src/domain; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,6}-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "TEAL_INTERNAL",
        "PUBLIC",
        "EXTERNAL",
        "DEMO",
        "CALCULATED",
        "INFERRED",
        "AI_GENERATED",
        "USER_CREATED"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "document": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "SOURCE_DOCUMENTED",
            "CALCULATED",
            "INFERRED",
            "DRAFT",
            "ASSUMPTION",
            "UNKNOWN",
            "CONFLICTED",
            "STALE"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "verification_status"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "manufactures",
              "uses",
              "compatible_with",
              "applies_to",
              "built_from",
              "supplied_by",
              "tested_by",
              "derived_from",
              "similar_to",
              "used_in",
              "requires",
              "validated_by",
              "learned_from",
              "belongs_to",
              "references",
              "evidence_for"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "rel",
          "target"
        ]
      }
    },
    "status": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "next_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "notes": {
      "type": "string"
    },
    "entity": {
      "type": "string",
      "const": "product"
    },
    "key": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "galvo",
        "galvo2",
        "gantry",
        "robot",
        "handpiece"
      ]
    },
    "source_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_source_key": {
      "type": "string"
    },
    "powers_w": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "powers_by_source": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "default_power_w": {
      "type": "number"
    },
    "lens_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_lens_key": {
      "type": "string"
    },
    "standard_content": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ]
      }
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lead_time_weeks": {
      "type": [
        "number",
        "null"
      ]
    },
    "warranty_months": {
      "type": [
        "number",
        "null"
      ]
    },
    "install_weeks": {
      "type": [
        "number",
        "null"
      ]
    },
    "base_price_inr": {
      "type": [
        "number",
        "null"
      ]
    },
    "maturity": {
      "type": "string",
      "enum": [
        "Idea",
        "Concept",
        "POC",
        "Prototype",
        "Pilot",
        "Product",
        "Platform",
        "Scale"
      ]
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source_key": {
            "type": "string"
          },
          "power_w": {
            "type": "number"
          },
          "material_key": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "name"
        ]
      }
    },
    "variant_of": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "data_type",
    "provenance",
    "entity",
    "key",
    "family_id",
    "code",
    "title",
    "delivery",
    "source_keys",
    "default_source_key",
    "powers_w",
    "default_power_w",
    "lens_keys",
    "default_lens_key",
    "standard_content",
    "specs",
    "industries",
    "lead_time_weeks",
    "warranty_months",
    "install_weeks",
    "base_price_inr",
    "applications"
  ]
}
