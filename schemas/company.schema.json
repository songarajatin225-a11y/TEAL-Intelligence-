{
  "$id": "https://songarajatin225-a11y.github.io/TEAL-Intelligence-/schemas/company.schema.json",
  "title": "Company",
  "description": "TEAL Engineering Intelligence OS — Company record (id prefix \"co-\"). Generated from src/domain; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,6}-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "TEAL_INTERNAL",
        "PUBLIC",
        "EXTERNAL",
        "DEMO",
        "CALCULATED",
        "INFERRED",
        "AI_GENERATED",
        "USER_CREATED"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "document": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "SOURCE_DOCUMENTED",
            "CALCULATED",
            "INFERRED",
            "DRAFT",
            "ASSUMPTION",
            "UNKNOWN",
            "CONFLICTED",
            "STALE"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "verification_status"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "manufactures",
              "uses",
              "compatible_with",
              "applies_to",
              "built_from",
              "supplied_by",
              "tested_by",
              "derived_from",
              "similar_to",
              "used_in",
              "requires",
              "validated_by",
              "learned_from",
              "belongs_to",
              "references",
              "evidence_for"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "rel",
          "target"
        ]
      }
    },
    "status": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "next_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "notes": {
      "type": "string"
    },
    "entity": {
      "type": "string",
      "const": "company"
    },
    "legal_name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "headquarters": {
      "type": "string"
    },
    "parent": {
      "type": "string"
    },
    "subsidiaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "customer",
          "supplier",
          "competitor",
          "manufacturer",
          "partner",
          "research"
        ]
      }
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "application_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "india_presence": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registry_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manufacturing_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rd_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    }
  },
  "required": [
    "id",
    "name",
    "data_type",
    "provenance",
    "entity"
  ]
}
