    "bom_id": {
      "type": "string"
    },
    "configuration_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "lines": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      }
    },
    "landed": {
      "type": "object",
      "properties": {
        "freightPct": {
          "type": "number"
        },
        "dutyPct": {
          "type": "number"
        },
        "landingPct": {
          "type": "number"
        },
        "gstPct": {
          "type": "number"
        },
        "siteContPct": {
          "type": "number"
        }
      },
      "required": [
        "freightPct",
        "dutyPct",
        "landingPct",
        "gstPct",
        "siteContPct"
      ]
