    "markup": {
      "type": "object",
      "properties": {
        "overheadPct": {
          "type": "number"
        },
        "contingencyPct": {
          "type": "number"
        },
        "profitPct": {
          "type": "number"
        }
      },
      "required": [
        "overheadPct",
        "contingencyPct",
        "profitPct"
      ]
    },
    "teal": {
      "type": "object",
      "properties": {
        "insurancePct": {
          "type": "number"
        },
        "sgaPct": {
          "type": "number"
        },
        "warrantyPct": {
          "type": "number"
        },
        "profitPct": {
          "type": "number"
        },
        "ossMonthly": {
          "type": "number"
        },
        "stationHc": {
          "type": "number"
        },
        "ossMonths": {
          "type": "number"
        },
        "packRate": {
          "type": "number"
        }
      },
      "required": [
        "insurancePct",
        "sgaPct",
        "warrantyPct",
        "profitPct",
        "ossMonthly",
        "stationHc",
        "ossMonths",
        "packRate"
      ]
