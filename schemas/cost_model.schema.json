    "economics": {
      "type": "object",
      "properties": {
        "annual_saving": {
          "type": [
            "number",
            "null"
          ]
        },
        "annual_parts": {
          "type": [
            "number",
            "null"
          ]
        },
        "life_years": {
          "type": [
            "number",
            "null"
          ]
        },
        "annual_operating_cost": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "fx": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "rate_to_inr": {
            "type": "number"
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "rate_to_inr",
          "as_of",
          "source"
        ]
      }
    },
    "scenario": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "data_type",
    "provenance",
    "entity",
    "currency",
    "qty",
    "lines",
    "landed",
    "markup"
