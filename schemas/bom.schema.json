{
  "$id": "https://songarajatin225-a11y.github.io/TEAL-Intelligence-/schemas/bom.schema.json",
  "title": "BOM",
  "description": "TEAL Engineering Intelligence OS — BOM record (id prefix \"bom-\"). Generated from src/domain; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,6}-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "TEAL_INTERNAL",
        "PUBLIC",
        "EXTERNAL",
        "DEMO",
        "CALCULATED",
        "INFERRED",
        "AI_GENERATED",
        "USER_CREATED"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "document": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "SOURCE_DOCUMENTED",
            "CALCULATED",
            "INFERRED",
            "DRAFT",
            "ASSUMPTION",
            "UNKNOWN",
            "CONFLICTED",
            "STALE"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "verification_status"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "manufactures",
              "uses",
              "compatible_with",
              "applies_to",
              "built_from",
              "supplied_by",
              "tested_by",
              "derived_from",
              "similar_to",
              "used_in",
              "requires",
              "validated_by",
              "learned_from",
              "belongs_to",
              "references",
              "evidence_for"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "rel",
          "target"
        ]
      }
    },
    "status": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "next_action": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][\\d:.]+Z?([+-]\\d{2}:?\\d{2})?)?$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "notes": {
      "type": "string"
    },
    "entity": {
      "type": "string",
      "const": "bom"
    },
    "bom_type": {
      "type": "string",
      "enum": [
        "EBOM",
        "MBOM",
        "Service BOM",
        "Spare BOM"
      ]
    },
    "revision": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "configuration_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string"
          },
          "parent_line_id": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "Product",
              "Assembly",
              "Subassembly",
              "Module",
              "Component"
            ]
          },
          "part_number": {
            "type": "string"
          },
          "item_code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "supplier": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "make_buy": {
            "type": "string",
            "enum": [
              "Make",
              "Buy"
            ]
          },
          "unit_cost": {
            "type": [
              "number",
              "null"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "INR",
              "USD",
              "EUR",
              "JPY",
              "GBP",
              "CNY"
            ]
          },
          "cost_basis": {
            "type": "string",
            "enum": [
              "QUOTED",
              "CATALOGUE",
              "ESTIMATE",
              "DEMO",
              "UNKNOWN"
            ]
          },
          "lead_time_weeks": {
            "type": [
              "number",
              "null"
            ]
          },
          "moq": {
            "type": [
              "number",
              "null"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High",
              "Unknown"
            ]
          },
          "alternate": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "module_id": {
            "type": "string"
          },
          "item_class": {
            "type": "string"
          },
          "import_item": {
            "type": "boolean"
          }
        },
        "required": [
          "line_id",
          "level",
          "description",
          "quantity",
          "unit",
          "make_buy",
          "unit_cost",
          "currency",
          "cost_basis"
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "data_type",
    "provenance",
    "entity",
    "bom_type",
    "revision",
    "lines"
  ]
}
