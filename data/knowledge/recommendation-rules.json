      "entity": "rule",
      "rule_type": "recommendation",
      "name": "Inline PCB traceability",
      "why": "Inline board marking is only auditable if every code is graded as it is made and failures are physically segregated.",
      "iff": {
        "plat": [
          "markc2i",
          "marku",
          "markit"
        ]
      },
      "then": {
        "mods": [
          "visver",
          "reject"
        ],
        "extra": [
          "mes"
        ],
        "sw": "inline"
      },
